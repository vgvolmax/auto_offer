{
  "name": "auto-offer-annotation-contract",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:annotation-schemas": "node scripts/annotation/generate-class-contracts.mjs",
    "generate:annotation-kits": "node scripts/annotation-kits/generate-annotation-kits.mjs",
    "check:annotation-schemas": "node scripts/check-annotation-contracts.mjs",
    "check:annotation-kits": "node scripts/annotation-kits/check-annotation-kits.mjs",
    "test:annotation-kits": "node --test tests/annotation-kits.test.mjs",
    "test:chat-prompts": "node --test tests/chat-annotation-prompts.test.mjs",
    "test:annotation": "node --test tests/annotation-*.test.mjs",
    "test:catalog": "node --test tests/catalog-*.test.mjs",
    "test:inventory": "node --test tests/inventory-*.test.mjs tests/public-taxonomy-reports.test.mjs",
    "catalog:inspect": "node scripts/catalog/inspect-price-workbooks.mjs",
    "catalog:extract": "node scripts/catalog/extract-price-lines.mjs",
    "catalog:propose-taxonomy": "node scripts/catalog/build-taxonomy-proposal.mjs",
    "catalog:validate": "node scripts/catalog/validate-catalog-inventory.mjs",
    "catalog:inventory": "npm run catalog:inspect && npm run catalog:extract && npm run catalog:propose-taxonomy && npm run catalog:validate",
    "taxonomy:review-pack": "node scripts/taxonomy/build-review-pack.mjs",
    "taxonomy:create-approval-draft": "node scripts/taxonomy/create-approval-draft.mjs",
    "taxonomy:validate-approval": "node scripts/taxonomy/validate-taxonomy-approval.mjs",
    "taxonomy:review-status": "node scripts/taxonomy/build-review-status.mjs",
    "test:taxonomy-review": "node --test tests/taxonomy-review-*.test.mjs",
    "test": "npm run check:annotation-schemas && npm run check:annotation-kits && npm run test:annotation-kits && npm run test:chat-prompts && npm run test:production-taxonomy && npm run test:annotation && npm run test:bundles && npm run test:catalog && npm run test:inventory && npm run test:taxonomy-review",
    "test:bundles": "node --test tests/catalog-bundle.test.mjs tests/request-bundle.test.mjs tests/bundle-cli.test.mjs",
    "validate:catalog-bundle": "node scripts/bundles/validate-catalog-bundle.mjs",
    "validate:request-bundle": "node scripts/bundles/validate-request-bundle.mjs",
    "taxonomy:validate-production": "node scripts/taxonomy/validate-production-taxonomy.mjs",
    "generate:annotation-fixtures": "node scripts/annotation/generate-class-fixtures.mjs",
    "test:production-taxonomy": "node --test tests/production-taxonomy.test.mjs",
    "test:annotation-classes": "node --test tests/annotation-class-generation.test.mjs tests/annotation-class-fixtures.test.mjs tests/annotation-production-semantics.test.mjs",
    "test:annotation-golden": "node --test tests/annotation-class-golden.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
