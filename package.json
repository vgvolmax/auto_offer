{
  "name": "auto-offer-annotation-contract",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:annotation-schemas": "node scripts/annotation/generate-class-contracts.mjs",
    "generate:annotation-kits": "node scripts/annotation-kits/generate-annotation-kits.mjs",
    "generate:catalog-validation-kit": "node scripts/catalog-validation-kit/generate-catalog-validation-kit.mjs",
    "generate:catalog-validation-kit-builder": "node scripts/catalog-validation-kit/generate-catalog-validation-kit-builder.mjs",
    "check:annotation-schemas": "node scripts/check-annotation-contracts.mjs",
    "check:annotation-kits": "node scripts/annotation-kits/check-annotation-kits.mjs",
    "check:catalog-validation-kit": "node scripts/catalog-validation-kit/check-catalog-validation-kit.mjs",
    "test:annotation-kits": "node --test tests/annotation-kits.test.mjs",
    "test:catalog-validation-kit": "node --test tests/catalog-validation-kit-*.test.mjs",
    "test:chat-prompts": "node --test tests/chat-annotation-prompts.test.mjs",
    "test:annotation": "node --test tests/annotation-*.test.mjs",
    "test:catalog": "node --test tests/catalog-*.test.mjs",
    "test:inventory": "node --test tests/inventory-*.test.mjs tests/public-taxonomy-reports.test.mjs",
    "catalog:inspect": "node scripts/catalog/inspect-price-workbooks.mjs",
    "catalog:extract": "node scripts/catalog/extract-price-lines.mjs",
    "catalog:propose-taxonomy": "node scripts/catalog/build-taxonomy-proposal.mjs",
    "catalog:validate": "node scripts/catalog/validate-catalog-inventory.mjs",
    "catalog:inventory": "npm run catalog:inspect && npm run catalog:extract && npm run catalog:propose-taxonomy && npm run catalog:validate",
    "taxonomy:review-pack": "node scripts/taxonomy/build-review-pack.mjs",
    "taxonomy:create-approval-draft": "node scripts/taxonomy/create-approval-draft.mjs",
    "taxonomy:validate-approval": "node scripts/taxonomy/validate-taxonomy-approval.mjs",
    "taxonomy:review-status": "node scripts/taxonomy/build-review-status.mjs",
    "test:taxonomy-review": "node --test tests/taxonomy-review-*.test.mjs",
    "test": "npm run validate:matching-contracts && npm run test:matching-contracts && npm run test:matcher-core && npm run test:matcher-golden && npm run check:annotation-schemas && npm run check:annotation-kits && npm run check:catalog-validation-kit && npm run test:annotation-kits && npm run test:chat-prompts && npm run test:production-taxonomy && npm run test:annotation && npm run test:bundles && npm run test:catalog && npm run test:inventory && npm run test:taxonomy-review && npm run typecheck:app && npm run test:app",
    "app:dev": "vite --config app/vite.config.ts",
    "app:build": "vite build --config app/vite.config.ts",
    "app:preview": "vite preview --config app/vite.config.ts",
    "test:app": "vitest run --config app/vite.config.ts",
    "test:pilot": "vitest run --config app/vite.config.ts src/test/pilot/pilot-fixtures.test.ts src/domain/pilot/pilot-runtime.test.ts src/features/sessions/pilot/PilotDiagnosticsPanel.test.tsx src/features/pilot/PilotWorkflow.test.tsx src/features/sessions/SessionPage.pilot.test.tsx src/storage/catalog-snapshot.pilot.test.ts src/features/pilot/PilotVolume.test.tsx",
    "typecheck:app": "tsc --project app/tsconfig.json --noEmit",
    "test:app:watch": "vitest --config app/vite.config.ts",
    "test:bundles": "node --test tests/catalog-bundle.test.mjs tests/request-bundle.test.mjs tests/bundle-cli.test.mjs",
    "validate:catalog-bundle": "node scripts/bundles/validate-catalog-bundle.mjs",
    "validate:request-bundle": "node scripts/bundles/validate-request-bundle.mjs",
    "taxonomy:validate-production": "node scripts/taxonomy/validate-production-taxonomy.mjs",
    "generate:annotation-fixtures": "node scripts/annotation/generate-class-fixtures.mjs",
    "test:production-taxonomy": "node --test tests/production-taxonomy.test.mjs",
    "test:annotation-classes": "node --test tests/annotation-class-generation.test.mjs tests/annotation-class-fixtures.test.mjs tests/annotation-production-semantics.test.mjs",
    "test:annotation-golden": "node --test tests/annotation-class-golden.test.mjs",
    "validate:matching-contracts": "node scripts/matching/validate-matching-contracts.mjs",
    "test:matching-contracts": "node --test tests/matching-contracts.test.mjs",
    "update:matching-golden-fingerprints": "node scripts/matching/update-golden-fingerprints.mjs",
    "test:matcher-core": "node --test tests/matcher-core.test.mjs",
    "test:matcher-golden": "node --test tests/matcher-golden.test.mjs"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "idb": "^8.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "fake-indexeddb": "^6.2.2",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
