{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chat-pipeline/taxonomy-light.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "taxonomy_schema_version", "taxonomy_version", "status", "class_count", "classes"],
  "properties": {
    "kind": { "const": "taxonomy_light" },
    "schema_version": { "const": "1.0.0" },
    "taxonomy_schema_version": { "type": "string", "minLength": 1 },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "status": { "const": "production" },
    "class_count": { "type": "integer", "minimum": 0 },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class_id", "family_id", "name_ru", "definition_ru", "include_rules_ru", "exclude_rules_ru"],
        "properties": {
          "class_id": { "type": "string", "minLength": 1 },
          "family_id": { "type": "string", "minLength": 1 },
          "name_ru": { "type": "string", "minLength": 1 },
          "definition_ru": { "type": "string", "minLength": 1 },
          "include_rules_ru": { "type": "array", "items": { "type": "string" } },
          "exclude_rules_ru": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
