{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chat-pipeline/request-routing.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "schema_version", "taxonomy_version", "source_file", "line_count", "routes"],
  "properties": {
    "kind": { "const": "request_routing" },
    "schema_version": { "const": "1.0.0" },
    "taxonomy_version": { "type": "string", "minLength": 1 },
    "source_file": { "type": "string", "minLength": 1 },
    "line_count": { "type": "integer", "minimum": 1 },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object", "additionalProperties": false,
            "required": ["line_id", "decision", "class_ids"],
            "properties": {
              "line_id": { "type": "string", "minLength": 1 },
              "decision": { "const": "candidates" },
              "class_ids": { "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
            }
          },
          {
            "type": "object", "additionalProperties": false,
            "required": ["line_id", "decision", "reason_code"],
            "properties": {
              "line_id": { "type": "string", "minLength": 1 },
              "decision": { "const": "unsupported" },
              "reason_code": { "enum": ["NO_TAXONOMY_CLASS", "AMBIGUOUS_CLASS", "UNCLASSIFIABLE_SOURCE"] }
            }
          }
        ]
      }
    }
  }
}
