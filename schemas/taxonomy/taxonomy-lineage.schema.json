{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.local/schemas/taxonomy/taxonomy-lineage.schema.json",
  "type":"object","additionalProperties":false,
  "required":["lineage_schema_version","proposal_version","production_taxonomy_version","proposal_sha256","mappings","case_created_classes","folded_resolutions"],
  "properties":{
    "lineage_schema_version":{"const":"1.0.0"},"proposal_version":{"const":"0.1.0"},"production_taxonomy_version":{"const":"1.0.0"},
    "proposal_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "mappings":{"type":"object","minProperties":27,"additionalProperties":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9]+(?:[._-][a-z0-9]+)*$"}}},
    "case_created_classes":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "folded_resolutions":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["from","to","discriminator"],"properties":{"from":{"type":"string"},"to":{"type":"string"},"discriminator":{"type":"object","additionalProperties":false,"required":["path","value"],"properties":{"path":{"type":"string"},"value":{"type":"string"}}}}}}
  }
}
