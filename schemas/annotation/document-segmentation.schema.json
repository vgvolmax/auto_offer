{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/document-segmentation.schema.json",
  "title": "AI document segmentation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "taxonomy_version", "document", "segments"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "taxonomy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "document_type"],
      "properties": {
        "source_file": {"type": "string", "minLength": 1},
        "document_type": {"enum": ["product_request", "company_card", "mixed", "unknown"]}
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segment_id", "segment_type", "raw_text", "source_position"],
        "properties": {
          "segment_id": {"type": "string", "minLength": 1},
          "segment_type": {"enum": ["product_line", "customer_details", "heading", "note", "table_header", "other"]},
          "raw_text": {"type": "string"},
          "source_position": {"$ref": "#/$defs/sourcePosition"},
          "candidate_class_ids": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["class_id", "confidence"],
              "properties": {
                "class_id": {"type": "string", "minLength": 1},
                "confidence": {"type": "number", "minimum": 0, "maximum": 1}
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "row": {"type": "integer", "minimum": 1},
        "sheet": {"type": "string"},
        "cell": {"type": "string"},
        "bounding_box": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}}
      },
      "minProperties": 1
    }
  }
}
