{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/catalog-item-annotation.base.schema.json",
  "title": "Base AI catalog item annotation (building block)",
  "$comment": "Not a production entry point; use generated catalog dispatcher.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "source_item_id",
    "class_id",
    "identity",
    "attributes",
    "ports",
    "annotation"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "source_item_id": {
      "type": "string",
      "minLength": 1
    },
    "class_id": {
      "$ref": "common.schema.json#/$defs/canonicalId"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand",
        "manufacturer",
        "manufacturer_articles",
        "models",
        "series"
      ],
      "properties": {
        "brand": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/canonicalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "manufacturer": {
          "anyOf": [
            {
              "$ref": "common.schema.json#/$defs/canonicalId"
            },
            {
              "type": "null"
            }
          ]
        },
        "manufacturer_articles": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "models": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "series": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "attributes": {
      "type": "object"
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "annotation": {
      "$ref": "#/$defs/annotation"
    }
  },
  "$defs": {
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "connection_kind"
      ],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "connection_kind": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "nominal_diameter_dn": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pipe_outer_diameter_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "pipe_wall_thickness_mm": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "thread_standard": {
          "type": "string",
          "minLength": 1
        },
        "thread_size": {
          "$ref": "common.schema.json#/$defs/rationalInch"
        }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unknown_fields",
        "issues",
        "ambiguities",
        "evidence"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/annotationStatus"
        },
        "class_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "unknown_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/jsonPointer"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/annotationIssue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/annotationIssue"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ambiguity"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          }
        },
        "operator_confirmations": {
          "type": "array",
          "items": { "$ref": "common.schema.json#/$defs/operatorConfirmation" }
        }
      }
    }
  }
}
