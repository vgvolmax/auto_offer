{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/request-line-annotation.base.schema.json",
  "title": "Base AI request line annotation (building block)",
  "$comment": "Not a production entry point; use generated request dispatcher.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "line_id",
    "raw_text",
    "class_id",
    "requested_identity",
    "constraints",
    "substitution_statement",
    "annotation"
  ],
  "properties": {
    "line_id": {
      "type": "string",
      "minLength": 1
    },
    "source_position": {
      "$ref": "common.schema.json#/$defs/sourcePosition"
    },
    "raw_text": {
      "type": "string"
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "unit"
      ],
      "properties": {
        "value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "unit": {
          "$ref": "common.schema.json#/$defs/canonicalQuantityUnit"
        }
      }
    },
    "class_id": {
      "$ref": "common.schema.json#/$defs/canonicalId"
    },
    "requested_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "brand": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        },
        "manufacturer": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        },
        "manufacturer_article": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        },
        "model": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        },
        "gtin": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        },
        "supplier_sku": {
          "$ref": "common.schema.json#/$defs/stringConstraint"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attributes",
        "ports"
      ],
      "properties": {
        "attributes": {
          "type": "object"
        },
        "ports": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "substitution_statement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy",
        "explicit",
        "raw_text"
      ],
      "properties": {
        "policy": {
          "enum": [
            "exact_only",
            "equivalent_allowed",
            "alternative_allowed",
            "unspecified"
          ]
        },
        "explicit": {
          "type": "boolean"
        },
        "raw_text": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "explicit": {
                "const": false
              }
            },
            "required": [
              "explicit"
            ]
          },
          "then": {
            "properties": {
              "policy": {
                "const": "unspecified"
              },
              "raw_text": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "explicit": {
                "const": true
              }
            },
            "required": [
              "explicit"
            ]
          },
          "then": {
            "properties": {
              "policy": {
                "not": {
                  "const": "unspecified"
                }
              },
              "raw_text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "unknown_fields",
        "issues",
        "ambiguities",
        "evidence"
      ],
      "properties": {
        "status": {
          "$ref": "common.schema.json#/$defs/annotationStatus"
        },
        "class_confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "unknown_fields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/jsonPointer"
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/annotationIssue"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/annotationIssue"
          }
        },
        "ambiguities": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/ambiguity"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/evidence"
          }
        }
      }
    }
  }
}
