{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/common.schema.json",
  "title": "Annotation contract v1.1 shared primitives",
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "pattern": "^(/([^~/]|~0|~1)*)+$"
    },
    "canonicalId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
    },
    "canonicalQuantityUnit": {
      "enum": [
        "piece",
        "meter",
        "set",
        "package",
        "coil"
      ]
    },
    "rationalInch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "numerator",
        "denominator",
        "unit"
      ],
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0
        },
        "denominator": {
          "type": "integer",
          "minimum": 1
        },
        "unit": {
          "const": "inch"
        }
      }
    },
    "sourcePosition": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "sheet": {
          "type": "string",
          "minLength": 1
        },
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "sourceSpan": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "integer",
          "minimum": 1
        },
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        }
      }
    },
    "annotationStatus": {
      "enum": [
        "validated",
        "needs_review",
        "invalid"
      ]
    },
    "annotationIssue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "json_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "details": {}
      }
    },
    "ambiguity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_pointer",
        "code",
        "source_text"
      ],
      "properties": {
        "json_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "source_text": {
          "type": "string"
        },
        "possible_values": {
          "type": "array",
          "items": {}
        },
        "blocking": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "json_pointer",
        "source_text"
      ],
      "properties": {
        "json_pointer": {
          "$ref": "#/$defs/jsonPointer"
        },
        "source_text": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {},
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "source_position": {
          "$ref": "#/$defs/sourcePosition"
        }
      }
    },
    "stringConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value"
          ],
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "neq"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "values"
          ],
          "properties": {
            "operator": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "enumConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value"
          ],
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "neq"
              ]
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "values"
          ],
          "properties": {
            "operator": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "rationalConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value"
          ],
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "neq"
              ]
            },
            "value": {
              "$ref": "#/$defs/rationalInch"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "values"
          ],
          "properties": {
            "operator": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "$ref": "#/$defs/rationalInch"
              }
            }
          }
        }
      ]
    },
    "numberConstraint": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "value"
          ],
          "properties": {
            "operator": {
              "enum": [
                "eq",
                "neq",
                "gte",
                "lte"
              ]
            },
            "value": {
              "type": "number"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "values"
          ],
          "properties": {
            "operator": {
              "const": "in"
            },
            "values": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "number"
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operator",
            "min",
            "max"
          ],
          "properties": {
            "operator": {
              "const": "between"
            },
            "min": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          }
        }
      ]
    },
    "setConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "values"
      ],
      "properties": {
        "operator": {
          "enum": [
            "contains_all",
            "contains_any"
          ]
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
