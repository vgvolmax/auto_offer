{
  "$id": "https://example.local/schemas/annotation/class-specific/accessory.pipe.protection.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "color": {
              "enum": [
                "black",
                "blue",
                "gray",
                "green",
                "metallic",
                "orange",
                "red",
                "transparent",
                "white",
                "yellow"
              ]
            },
            "compatible_pipe_outer_diameter_mm": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "protection_kind": {
              "enum": [
                "cover",
                "decorative_plate",
                "protective_insert",
                "sleeve",
                "wall_passage"
              ]
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "accessory.pipe.protection"
        },
        "ports": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "compatible_pipe_outer_diameter_mm",
              "protection_kind"
            ]
          },
          "ports": {
            "maxItems": 0
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Защитное комплектующее для труб"
}
