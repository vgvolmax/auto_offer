{
  "$id": "https://example.local/schemas/annotation/class-specific/pipe.pex_a.request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../request-line-annotation.base.schema.json"
    },
    {
      "properties": {
        "class_id": {
          "const": "pipe.pex_a"
        },
        "constraints": {
          "properties": {
            "attributes": {
              "additionalProperties": false,
              "properties": {
                "barrier_layer": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                },
                "coil_length_m": {
                  "$ref": "../common.schema.json#/$defs/numberConstraint"
                },
                "color": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                },
                "wall_thickness_mm": {
                  "$ref": "../common.schema.json#/$defs/numberConstraint"
                }
              },
              "type": "object"
            },
            "ports": {
              "items": {
                "oneOf": [
                  {
                    "additionalProperties": false,
                    "properties": {
                      "connection_kind": {
                        "$ref": "../common.schema.json#/$defs/enumConstraint"
                      },
                      "pipe_outer_diameter_mm": {
                        "$ref": "../common.schema.json#/$defs/numberConstraint"
                      },
                      "role": {
                        "const": "pipe_end"
                      },
                      "system": {
                        "$ref": "../common.schema.json#/$defs/enumConstraint"
                      }
                    },
                    "required": [
                      "role"
                    ],
                    "type": "object"
                  }
                ]
              },
              "maxItems": 2,
              "type": "array"
            }
          },
          "type": "object"
        }
      },
      "type": "object"
    }
  ],
  "title": "Request line annotation: Труба PE-Xa"
}
