{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/class-specific/fitting.adapter.ppr.male_thread.request.schema.json",
  "title": "Request line annotation: PPR adapter with male thread",
  "allOf": [
    {
      "$ref": "../request-line-annotation.base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "class_id": {
          "const": "fitting.adapter.ppr.male_thread"
        },
        "constraints": {
          "type": "object",
          "properties": {
            "attributes": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "body_material": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                },
                "construction": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                },
                "color": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                },
                "pressure_class": {
                  "$ref": "../common.schema.json#/$defs/enumConstraint"
                }
              }
            },
            "ports": {
              "type": "array",
              "maxItems": 2,
              "items": {
                "oneOf": [
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "const": "pipe"
                      },
                      "pipe_outer_diameter_mm": {
                        "$ref": "../common.schema.json#/$defs/numberConstraint"
                      }
                    }
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "role"
                    ],
                    "properties": {
                      "role": {
                        "const": "thread"
                      },
                      "thread_standard": {
                        "$ref": "../common.schema.json#/$defs/enumConstraint"
                      },
                      "thread_size": {
                        "$ref": "../common.schema.json#/$defs/rationalConstraint"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
