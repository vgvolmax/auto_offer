{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/class-specific/fitting.adapter.ppr.male_thread.catalog.schema.json",
  "title": "Catalog annotation: PPR adapter with male thread",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "type": "object",
      "properties": {
        "class_id": {
          "const": "fitting.adapter.ppr.male_thread"
        },
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body_material": {
              "enum": [
                "PP-R",
                "PP-RCT"
              ]
            },
            "construction": {
              "enum": [
                "one_piece",
                "detachable_union"
              ]
            },
            "color": {
              "type": "string",
              "minLength": 1
            },
            "pressure_class": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "ports": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "pipe"
                },
                "connection_kind": {
                  "const": "socket_fusion"
                },
                "system": {
                  "const": "PPR"
                },
                "pipe_outer_diameter_mm": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "role"
              ],
              "properties": {
                "role": {
                  "const": "thread"
                },
                "connection_kind": {
                  "const": "male_thread"
                },
                "thread_standard": {
                  "type": "string",
                  "minLength": 1
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                }
              }
            }
          ]
        }
      },
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "body_material"
            ]
          },
          "ports": {
            "prefixItems": [
              {
                "required": [
                  "connection_kind",
                  "system",
                  "pipe_outer_diameter_mm"
                ]
              },
              {
                "required": [
                  "connection_kind",
                  "thread_standard",
                  "thread_size"
                ]
              }
            ]
          }
        }
      }
    }
  ]
}
