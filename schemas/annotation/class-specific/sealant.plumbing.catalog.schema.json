{
  "$id": "https://example.local/schemas/annotation/class-specific/sealant.plumbing.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "sealant_kind": {
              "enum": [
                "anaerobic",
                "polymer",
                "sealing_paste",
                "silicone"
              ]
            },
            "strength": {
              "enum": [
                "high",
                "low",
                "medium"
              ]
            },
            "viscosity": {
              "enum": [
                "high",
                "low",
                "medium"
              ]
            },
            "volume_ml": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "sealant.plumbing"
        },
        "ports": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "sealant_kind"
            ]
          },
          "ports": {
            "maxItems": 0
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Сантехнический герметик"
}
