{
  "$id": "https://example.local/schemas/annotation/class-specific/seal.sewer.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "compatible_system": {
              "enum": [
                "hdpe",
                "multilayer",
                "pe_rt",
                "pe_xa",
                "ppr",
                "sewer_external",
                "sewer_internal",
                "sewer_low_noise",
                "threaded_generic"
              ]
            },
            "material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "nominal_diameter_mm": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "seal_kind": {
              "enum": [
                "gasket",
                "lip_seal",
                "o_ring",
                "repair_seal"
              ]
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "seal.sewer"
        },
        "ports": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "nominal_diameter_mm",
              "seal_kind"
            ]
          },
          "ports": {
            "maxItems": 0
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Уплотнение канализации"
}
