{
  "$id": "https://example.local/schemas/annotation/class-specific/fitting.radial.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "body_material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "profile": {
              "enum": [
                "b",
                "h",
                "rf",
                "th",
                "u"
              ]
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "fitting.radial"
        },
        "ports": {
          "items": false,
          "maxItems": 3,
          "minItems": 0,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "radial_press",
                    "male_thread",
                    "female_thread"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "end_1"
                },
                "system": {
                  "enum": [
                    "multilayer",
                    "pe_rt",
                    "pe_xa",
                    "threaded_generic"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "radial_press",
                    "male_thread",
                    "female_thread"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "end_2"
                },
                "system": {
                  "enum": [
                    "multilayer",
                    "pe_rt",
                    "pe_xa",
                    "threaded_generic"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "radial_press",
                    "male_thread",
                    "female_thread"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "branch_1"
                },
                "system": {
                  "enum": [
                    "multilayer",
                    "pe_rt",
                    "pe_xa",
                    "threaded_generic"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "profile"
            ]
          },
          "ports": {
            "minItems": 1,
            "prefixItems": [
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              }
            ]
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Радиальный пресс-фитинг"
}
