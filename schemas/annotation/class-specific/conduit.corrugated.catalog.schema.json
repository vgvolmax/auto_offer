{
  "$id": "https://example.local/schemas/annotation/class-specific/conduit.corrugated.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "coil_length_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "color": {
              "enum": [
                "black",
                "blue",
                "gray",
                "green",
                "metallic",
                "orange",
                "red",
                "transparent",
                "white",
                "yellow"
              ]
            },
            "inner_diameter_mm": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "conduit.corrugated"
        },
        "ports": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "inner_diameter_mm"
            ]
          },
          "ports": {
            "maxItems": 0
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Защитная гофрированная оболочка"
}
