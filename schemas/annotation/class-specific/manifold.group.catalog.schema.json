{
  "$id": "https://example.local/schemas/annotation/class-specific/manifold.group.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "body_material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "control_equipment": {
              "enum": [
                "flowmeters",
                "manual_valves",
                "mixing_control",
                "none",
                "thermostatic_valves"
              ]
            },
            "includes_air_vents": {
              "type": "boolean"
            },
            "includes_drain_valves": {
              "type": "boolean"
            },
            "includes_flowmeters": {
              "type": "boolean"
            },
            "outlet_count": {
              "exclusiveMinimum": 0,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "manifold.group"
        },
        "ports": {
          "items": false,
          "maxItems": 3,
          "minItems": 0,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "male_thread",
                    "female_thread",
                    "socket_fusion",
                    "compression",
                    "union"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "main_inlet"
                },
                "system": {
                  "enum": [
                    "threaded_generic",
                    "ppr",
                    "hdpe",
                    "multilayer"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "male_thread",
                    "female_thread",
                    "socket_fusion",
                    "compression",
                    "union"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "main_outlet"
                },
                "system": {
                  "enum": [
                    "threaded_generic",
                    "ppr",
                    "hdpe",
                    "multilayer"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "male_thread",
                    "female_thread",
                    "socket_fusion",
                    "compression",
                    "union"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "branch"
                },
                "system": {
                  "enum": [
                    "threaded_generic",
                    "ppr",
                    "hdpe",
                    "multilayer"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "body_material",
              "control_equipment",
              "outlet_count"
            ]
          },
          "ports": {
            "minItems": 3,
            "prefixItems": [
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              }
            ]
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Коллекторная группа"
}
