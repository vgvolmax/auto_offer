{
  "$id": "https://example.local/schemas/annotation/class-specific/valve.radiator.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "body_material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "control_type": {
              "enum": [
                "manual",
                "presettable",
                "thermostatic"
              ]
            },
            "pressure_class": {
              "enum": [
                "pn10",
                "pn12_5",
                "pn16",
                "pn20",
                "pn25",
                "pn40",
                "pn6"
              ]
            },
            "valve_form": {
              "enum": [
                "angle",
                "axial",
                "straight"
              ]
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "valve.radiator"
        },
        "ports": {
          "items": false,
          "maxItems": 2,
          "minItems": 0,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "male_thread",
                    "female_thread",
                    "socket_fusion",
                    "compression",
                    "union"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "pipe"
                },
                "system": {
                  "enum": [
                    "threaded_generic",
                    "ppr",
                    "hdpe",
                    "multilayer",
                    "pe_rt",
                    "pe_xa"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "enum": [
                    "male_thread",
                    "female_thread",
                    "socket_fusion",
                    "compression",
                    "union"
                  ]
                },
                "nominal_diameter_dn": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "pipe_wall_thickness_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "radiator"
                },
                "system": {
                  "enum": [
                    "threaded_generic",
                    "ppr",
                    "hdpe",
                    "multilayer",
                    "pe_rt",
                    "pe_xa"
                  ]
                },
                "thread_size": {
                  "$ref": "../common.schema.json#/$defs/rationalInch"
                },
                "thread_standard": {
                  "minLength": 1,
                  "type": "string"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "control_type",
              "valve_form"
            ]
          },
          "ports": {
            "minItems": 2,
            "prefixItems": [
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind"
                ]
              }
            ]
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Радиаторный клапан"
}
