{
  "$id": "https://example.local/schemas/annotation/class-specific/pipe.ppr.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "body_material": {
              "enum": [
                "aluminum",
                "brass",
                "cast_iron",
                "epdm",
                "hdpe",
                "multilayer",
                "nylon",
                "pe_rt",
                "pe_xa",
                "polypropylene",
                "ppr",
                "pprct",
                "ptfe",
                "pvc",
                "rubber",
                "silicone",
                "stainless_steel",
                "steel"
              ]
            },
            "color": {
              "enum": [
                "black",
                "blue",
                "gray",
                "green",
                "metallic",
                "orange",
                "red",
                "transparent",
                "white",
                "yellow"
              ]
            },
            "length_m": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "pressure_class": {
              "enum": [
                "pn10",
                "pn12_5",
                "pn16",
                "pn20",
                "pn25",
                "pn40",
                "pn6"
              ]
            },
            "sdr": {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            "wall_thickness_mm": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "pipe.ppr"
        },
        "ports": {
          "items": false,
          "maxItems": 2,
          "minItems": 0,
          "prefixItems": [
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "const": "plain_end"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "pipe_end"
                },
                "system": {
                  "const": "ppr"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            },
            {
              "additionalProperties": false,
              "properties": {
                "connection_kind": {
                  "const": "plain_end"
                },
                "pipe_outer_diameter_mm": {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                "role": {
                  "const": "pipe_end"
                },
                "system": {
                  "const": "ppr"
                }
              },
              "required": [
                "role"
              ],
              "type": "object"
            }
          ],
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "body_material",
              "wall_thickness_mm"
            ]
          },
          "ports": {
            "minItems": 2,
            "prefixItems": [
              {
                "required": [
                  "role",
                  "connection_kind",
                  "system",
                  "pipe_outer_diameter_mm"
                ]
              },
              {
                "required": [
                  "role",
                  "connection_kind",
                  "system",
                  "pipe_outer_diameter_mm"
                ]
              }
            ]
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Труба PP-R"
}
