{
  "$id": "https://example.local/schemas/annotation/class-specific/fluid.heat_transfer.catalog.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$ref": "../catalog-item-annotation.base.schema.json"
    },
    {
      "if": {
        "properties": {
          "annotation": {
            "properties": {
              "status": {
                "const": "validated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "annotation"
        ]
      },
      "properties": {
        "attributes": {
          "additionalProperties": false,
          "properties": {
            "base_fluid": {
              "enum": [
                "ethylene_glycol",
                "propylene_glycol",
                "water"
              ]
            },
            "fluid_kind": {
              "enum": [
                "antifreeze",
                "corrosion_inhibitor",
                "heat_transfer_fluid"
              ]
            },
            "freezing_point_c": {
              "type": "number"
            },
            "operating_temperature_max_c": {
              "type": "number"
            },
            "volume_l": {
              "exclusiveMinimum": 0,
              "type": "number"
            }
          },
          "type": "object"
        },
        "class_id": {
          "const": "fluid.heat_transfer"
        },
        "ports": {
          "items": false,
          "maxItems": 0,
          "type": "array"
        }
      },
      "then": {
        "properties": {
          "attributes": {
            "required": [
              "base_fluid",
              "fluid_kind"
            ]
          },
          "ports": {
            "maxItems": 0
          }
        }
      },
      "type": "object"
    }
  ],
  "title": "Catalog annotation: Теплоноситель и антифриз"
}
