{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/annotation/request-document.base.schema.json",
  "title": "Production AI request annotation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "taxonomy_version",
    "request_id",
    "document",
    "lines"
  ],
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "taxonomy_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_file",
        "document_type"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "minLength": 1
        },
        "document_type": {
          "const": "product_request"
        }
      }
    },
    "customer": {
      "type": [
        "object",
        "null"
      ]
    },
    "lines": {
      "type": "array",
      "items": {
        "$ref": "generated/request-line.dispatch.schema.json"
      }
    }
  }
}
