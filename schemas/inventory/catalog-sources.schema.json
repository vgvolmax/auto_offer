{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.local/schemas/inventory/catalog-sources.schema.json","type":"object","additionalProperties":false,"required":["config_schema_version","source_root","sources"],"properties":{"config_schema_version":{"const":"1.0.0"},"source_root":{"type":"string","minLength":1},"sources":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}},"$defs":{"columnMap":{"type":"object","additionalProperties":false,"required":["supplier_sku","name"],"properties":{"supplier_sku":{"type":"string","pattern":"^[A-Z]+$"},"name":{"type":"string","pattern":"^[A-Z]+$"},"gtin":{"type":"string","pattern":"^[A-Z]+$"},"unit":{"type":"string","pattern":"^[A-Z]+$"},"description":{"type":"string","pattern":"^[A-Z]+$"}}},"sheet":{"type":"object","additionalProperties":false,"required":["name","header_row","columns","row_predicate"],"properties":{"name":{"type":"string","minLength":1},"header_row":{"type":"integer","minimum":1},"columns":{"$ref":"#/$defs/columnMap"},"context_columns":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z]+$"}},"carry_forward_context_columns":{"type":"array","uniqueItems":true,"items":{"type":"string","pattern":"^[A-Z]+$"}},"row_predicate":{"enum":["sku_and_name","name_only"]}}},"ignoredSheet":{"type":"object","additionalProperties":false,"required":["name","reason"],"properties":{"name":{"type":"string","minLength":1},"reason":{"type":"string","minLength":1}}},"source":{"type":"object","additionalProperties":false,"required":["source_id","filename","price_pool","sheets","ignored_sheets"],"properties":{"source_id":{"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},"filename":{"type":"string","pattern":"\\.(?:xlsx|xlsm)$"},"price_pool":{"type":"string","minLength":1},"sheets":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/sheet"}},"ignored_sheets":{"type":"array","items":{"$ref":"#/$defs/ignoredSheet"}}}}}}
