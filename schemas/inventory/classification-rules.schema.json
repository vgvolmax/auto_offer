{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/inventory/classification-rules.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules_schema_version",
    "proposal_version",
    "status",
    "classes",
    "rules"
  ],
  "properties": {
    "rules_schema_version": {"const": "1.0.0"},
    "proposal_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"const": "proposed"},
    "classes": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/classDefinition"}},
    "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/rule"}}
  },
  "$defs": {
    "classDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name_ru", "family_id", "candidate_attributes", "candidate_ports"],
      "properties": {
        "name_ru": {"type": "string", "minLength": 1},
        "family_id": {"type": "string", "minLength": 1},
        "candidate_attributes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "candidate_ports": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "candidate_value_set_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "class_id", "priority", "rationale"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "class_id": {"type": "string", "minLength": 1},
        "priority": {"type": "integer"},
        "rationale": {"type": "string", "minLength": 1},
        "all_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "any_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "excluded_tokens": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "exact_normalized_phrase": {"type": "string", "minLength": 1},
        "regex": {"type": "string", "minLength": 1},
        "exact_context": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sheet_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "anyOf": [
        {"required": ["all_tokens"]},
        {"required": ["any_tokens"]},
        {"required": ["exact_normalized_phrase"]},
        {"required": ["regex"]},
        {"required": ["exact_context"]},
        {"required": ["source_ids"]},
        {"required": ["sheet_names"]}
      ]
    }
  }
}
