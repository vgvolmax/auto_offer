{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://example.local/schemas/inventory/catalog-inventory-record.schema.json","type":"object","additionalProperties":false,"required":["inventory_schema_version","source_file","source_item_id","source","raw","normalized","row_status","taxonomy_status","cluster_id","proposed_class_ids","matched_rule_ids","duplicate_flags","diagnostics","source_fingerprint"],"properties":{"inventory_schema_version":{"const":"1.0.0"},"source_file":{"type":"object","additionalProperties":false,"required":["source_id","filename","sha256"],"properties":{"source_id":{"type":"string","minLength":1},"filename":{"type":"string","minLength":1},"sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},"source_item_id":{"type":"string","minLength":1},"source":{"type":"object","additionalProperties":false,"required":["sheet","row","hidden"],"properties":{"sheet":{"type":"string","minLength":1},"row":{"type":"integer","minimum":1},"hidden":{"type":"boolean"}}},"raw":{"type":"object","additionalProperties":false,"required":["name","description","supplier_sku","gtin","unit","category_context"],"properties":{"name":{"type":["string","null"]},"description":{"type":["string","null"]},"supplier_sku":{"type":["string","null"]},"gtin":{"type":["string","null"]},"unit":{"type":["string","null"]},"category_context":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}}}},"normalized":{"type":"object","additionalProperties":false,"required":["name","name_skeleton","tokens"],"properties":{"name":{"type":"string"},"name_skeleton":{"type":"string"},"tokens":{"type":"array","items":{"type":"string","minLength":1}}}},"row_status":{"enum":["product_candidate","non_product","data_error"]},"taxonomy_status":{"enum":["proposed_mapped","ambiguous","unsupported","not_applicable"]},"cluster_id":{"type":["string","null"],"pattern":"^cluster:[0-9a-f]{16}$"},"proposed_class_ids":{"type":"array","uniqueItems":true,"items":{"type":"string","p